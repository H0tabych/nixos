{ config, pkgs, ... }:

{
  # ============================================================
  # ВНЕШНИЕ ЗАВИСИМОСТИ NEOVIM
  # ============================================================
  # Все бинарники, которые Neovim использует, устанавливаются здесь.
  # Это гарантирует воспроизводимость и переносимость.
  # При переносе на другой дистрибутив — достаточно установить
  # эти пакеты через apt/pacman/etc.

  home.packages = with pkgs; [
    # === Базовые утилиты ===
    git           # Для lazy.nvim и плагинов
    gnumake       # Для компиляции некоторых плагинов
    gcc           # Компилятор C (для Treesitter и др.)
    curl          # Для загрузки файлов
    wget          # Альтернатива curl
    unzip         # Для распаковки
    gnutar        # Для распаковки tar
    ripgrep       # Быстрый поиск текста (для Telescope)
    fd            # Быстрый поиск файлов (для Telescope)

    # === Буфер обмена ===
    # В Wayland: wl-copy/wl-paste
    # В X11: xclip или xsel
    # Neovim автоматически выберет подходящий
    wl-clipboard  # Wayland clipboard
    xclip         # X11 clipboard (на всякий случай)

    tree-sitter

    # === Опционально: для будущих этапов ===
    # Эти пакеты понадобятся, когда мы добавим LSP/DAP
    # Пока закомментируем, чтобы не устанавливать лишнее
    # nodejs        # Для pyright, typescript-language-server
    # python3       # Для некоторых LSP
    # rustc         # Для rust-analyzer
    # cargo         # Для rust-analyzer
  ];

  # ============================================================
  # ПОРТативная КОНФИГУРАЦИЯ
  # ============================================================
  # Связываем нашу директорию с ~/.config/nvim
  # Это работает и на NixOS, и на любом другом дистрибутиве
  # (через install.sh, который мы добавим позже)
  xdg.configFile."nvim".source = ./nvim-lazy-config;

  # ============================================================
  # УСТАНОВКА NEOVIM
  # ============================================================
  programs.neovim = {
    enable = true;
    defaultEditor = true;    # Сделать nvim редактором по умолчанию
    viAlias = true;          # vi → nvim
    vimAlias = true;         # vim → nvim

    # ВАЖНО: отключаем генерацию конфигов Home Manager
    # Вся конфигурация — в нашей портативной директории
    extraConfig = "";
    extraLuaConfig = "";
    extraPackages = [];
  };
}

